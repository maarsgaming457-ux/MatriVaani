# MatriVaani Environment Variables Template
# DO NOT ADD REAL SECRETS TO THIS FILE.

# 1. Hugging Face Access (Required for some base models)
HF_TOKEN=

# 2. Sarvam API Configuration (If using cloud fallback TTS/ASR)
SARVAM_API_KEY=

# 3. Groq API Configuration (For experimental offline capabilities/LLMs)
GROQ_API_KEY=

# 4. Bhashini Credentials (If required for specific endpoints)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# 5. Application Configuration
ENVIRONMENT=development
DEBUG=True
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
